# Backend API URL (iOS simulator: http://localhost:8080, Android emulator: http://10.0.2.2:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google Maps SDK for Android の API キー（Android の地図表示に必須。iOS は不要）
# Google Cloud でパッケージ名 + SHA-1 による制限をかけること（docs/google-play-submission.md §2-2）
GOOGLE_MAPS_API_KEY=
