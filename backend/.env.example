# Database (GORM DSN format)
DATABASE_URL="user:password@tcp(localhost:3306)/kintore-board?charset=utf8mb4&parseTime=True&loc=Local"
PRISMA_DATABASE_URL=mysql://user:password@localhost:3306/kintore-board

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

# Minio (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kintore-board
MINIO_USE_SSL=false

# 端末から直接到達できる公開ホスト。署名済みURLはこのホスト名で署名される。
# S3の署名はHostを含むため、発行後にホスト名を書き換えると署名が壊れる。
# LAN内のIPを MINIO_ENDPOINT に入れている場合、これを設定しないと外部から画像を
# アップロード/表示できない。未設定なら MINIO_ENDPOINT にフォールバックする。
# "host:port" でも "https://host" でも可。
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=true

# 署名時のリージョン。指定しないと署名のたびに GetBucketLocation の通信が走る。
MINIO_REGION=us-east-1

# Server (optional)
PORT=8080
GIN_MODE=debug
