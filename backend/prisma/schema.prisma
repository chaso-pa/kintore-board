generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String   @id @default(uuid())
  deviceUuid      String   @unique @map("device_uuid")
  status          String   @default("active")
  // status は認証状態 (active / blocked)。role は権限で、別の概念として扱う。
  // 昇格は prisma studio または SQL による手動操作で、昇格用のエンドポイントは無い。
  role            String   @default("user")
  moderationScore Int      @default(0) @map("moderation_score")
  createdAt       DateTime @default(now()) @map("created_at")

  threads       Thread[]
  posts         Post[]
  workouts      Workout[]
  reports       Report[]
  gyms          Gym[]
  machines      Machine[]
  bookmarks     ThreadBookmark[]
  editRequests  GymEditRequest[]
  gymFavorites  GymFavorite[]
  // ブロックは向きのある関係なので、同じテーブルへの relation が2本になる。
  // Prisma は2本以上あると名前で区別を要求するため、両側に名前を付けている。
  blocksMade     UserBlock[] @relation("BlocksMade")
  blocksReceived UserBlock[] @relation("BlocksReceived")

  @@map("users")
}

model Gym {
  id               String    @id @default(uuid())
  name             String
  address          String?
  latitude         Float?
  longitude        Float?
  visitorFee       Int?      @map("visitor_fee")
  monthlyFee       Int?      @map("monthly_fee")
  visitorAvailable Boolean   @default(false) @map("visitor_available")
  description      String?   @db.Text
  hours            String?
  hasParking       Boolean   @default(false) @map("has_parking")
  hasShower        Boolean   @default(false) @map("has_shower")
  hasLockerRoom    Boolean   @default(false) @map("has_locker_room")
  dumbbellMaxKg    Int?      @map("dumbbell_max_kg")
  barbellType      String?   @map("barbell_type")
  powerRackCount   Int?      @map("power_rack_count")
  sourceType       String    @default("user") @map("source_type")
  // モデレーション状態 (pending / active / rejected)。既存行を公開のまま残すため
  // デフォルトは active で、新規作成はコード側が明示的に pending を入れる。
  status           String    @default("active")
  lastUpdatedAt    DateTime  @updatedAt @map("last_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String    @map("created_by_user_id")

  createdBy    User             @relation(fields: [createdByUserId], references: [id])
  gymMachines  GymMachine[]
  threads      Thread[]
  photos       GymPhoto[]
  editRequests GymEditRequest[]
  favorites    GymFavorite[]

  @@map("gyms")
}

model GymPhoto {
  id               String @id @default(uuid())
  gymId            String @map("gym_id")
  imageUrl         String @map("image_url")
  uploadedByUserId String @map("uploaded_by_user_id")
  status           String @default("active")
  // 「最古の pending の経過時間」を写真についても出せるようにするために追加した。
  // 既存行が「今」になるが、この指標は pending 行しか読まず既存行は全て active なので影響しない。
  createdAt        DateTime @default(now()) @map("created_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@map("gym_photos")
}

model Machine {
  id              String   @id @default(uuid())
  name            String
  manufacturer    String?
  bodyPart        String?  @map("body_part")
  category        String?
  notes           String?  @db.Text
  createdByUserId String   @map("created_by_user_id")
  // Gym.status と同じ規約。既存行は active、新規はコード側で pending。
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")

  createdBy   User         @relation(fields: [createdByUserId], references: [id])
  gymMachines GymMachine[]
  threads     Thread[]
  photos      MachinePhoto[]

  @@map("machines")
}

model GymMachine {
  gymId     String @map("gym_id")
  machineId String @map("machine_id")

  gym     Gym     @relation(fields: [gymId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])

  @@id([gymId, machineId])
  @@map("gym_machines")
}

model MachinePhoto {
  id               String @id @default(uuid())
  machineId        String @map("machine_id")
  imageUrl         String @map("image_url")
  uploadedByUserId String @map("uploaded_by_user_id")
  status           String @default("active")
  // GymPhoto.createdAt と同じ理由。
  createdAt        DateTime @default(now()) @map("created_at")

  machine Machine @relation(fields: [machineId], references: [id])

  @@map("machine_photos")
}

model Thread {
  id              String   @id @default(uuid())
  type            String
  title           String
  category        String?
  gymId           String?  @map("gym_id")
  machineId       String?  @map("machine_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  status          String   @default("active")

  createdBy User             @relation(fields: [createdByUserId], references: [id])
  gym       Gym?             @relation(fields: [gymId], references: [id])
  machine   Machine?         @relation(fields: [machineId], references: [id])
  posts     Post[]
  bookmarks ThreadBookmark[]

  @@map("threads")
}

model ThreadBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  threadId  String   @map("thread_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  thread Thread @relation(fields: [threadId], references: [id])

  @@unique([userId, threadId])
  @@map("thread_bookmarks")
}

model Post {
  id                String   @id @default(uuid())
  threadId          String   @map("thread_id")
  userId            String   @map("user_id")
  anonymousThreadId String   @map("anonymous_thread_id")
  replyToId         String?  @map("reply_to_id")
  body              String   @db.Text
  helpfulCount      Int      @default(0) @map("helpful_count")
  createdAt         DateTime @default(now()) @map("created_at")
  status            String   @default("active")

  thread Thread @relation(fields: [threadId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("posts")
}

model Workout {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  trainedOn DateTime @map("trained_on")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User         @relation(fields: [userId], references: [id])
  sets WorkoutSet[]

  @@map("workouts")
}

model WorkoutSet {
  id           String  @id @default(uuid())
  workoutId    String  @map("workout_id")
  exerciseName String  @map("exercise_name")
  weight       Float?
  reps         Int?
  sets         Int?
  memo         String?
  spotted      Boolean @default(false)
  sortOrder    Int     @default(0) @map("sort_order")
  // Nullable on purpose: every row written before this column existed has no body part, and
  // the server cannot infer one — custom exercises and custom parts live only on the device
  // that created them. NULL means "not classified yet"; the owning device fills it in.
  bodyPart     String? @map("body_part")

  workout Workout @relation(fields: [workoutId], references: [id])

  @@map("workout_sets")
}

model Report {
  id               String   @id @default(uuid())
  targetType       String   @map("target_type")
  targetId         String   @map("target_id")
  reportedByUserId String   @map("reported_by_user_id")
  // 理由コード (harassment / personal_attack / ...)。表示文言はアプリ側が持つ。
  reason           String
  // 「その他」を選んだときに何が問題なのかを書く欄。コードだけでは対応の判断が
  // つかない通報が必ず出るので、任意入力で受け取れるようにしておく。
  detail           String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  status           String   @default("pending")

  reportedBy User @relation(fields: [reportedByUserId], references: [id])

  // 同じ人が同じ対象を何度通報しても行は1つ。件数をそのまま「何人が通報したか」
  // として読めるようにするためで、連打で対応キューが埋まるのも同時に防ぐ。
  @@unique([reportedByUserId, targetType, targetId])
  // 管理キューは未対応のものを古い順に読む。
  @@index([status, createdAt])
  // 1件の投稿に何件集まっているかを引くため。
  @@index([targetType, targetId])
  @@map("reports")
}

// ある人が別の人を見えなくした、という一方向の記録。
//
// 非表示は双方向に効く（ブロックした側もされた側も互いの投稿が見えなくなる）が、
// 行としては向きを残す: 解除できるのはブロックした本人だけで、それは
// blocker_user_id を見ないと決められない。
//
// 相手が誰かはアプリに渡らない。ブロックは post_id で要求し、サーバが著者を引く。
// 匿名IDしか表に出ない設計なので、ここで user_id を返すと匿名性が崩れる。
model UserBlock {
  id            String   @id @default(uuid())
  blockerUserId String   @map("blocker_user_id")
  blockedUserId String   @map("blocked_user_id")
  // ブロックのきっかけになった投稿の冒頭。解除画面で「どれを消したのか」を
  // 示すためだけに持つ。投稿が後で削除されても解除画面が空欄にならないよう、
  // 参照ではなく複製して持っている。
  sourceExcerpt String?  @map("source_excerpt") @db.VarChar(80)
  createdAt     DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksMade", fields: [blockerUserId], references: [id])
  blocked User @relation("BlocksReceived", fields: [blockedUserId], references: [id])

  // 同じ相手を二重にブロックできない。再ブロックは成功として扱うので、
  // ここは競合したリクエストの後発を落とすための保険。
  @@unique([blockerUserId, blockedUserId])
  // 一覧のフィルタは「自分がブロックした人」と「自分をブロックした人」の
  // 両方を引く。後者は blocked_user_id 側からの検索になる。
  @@index([blockedUserId])
  @@map("user_blocks")
}

model GymEditRequest {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  userId    String   @map("user_id")
  category  String
  body      String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  gym  Gym  @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("gym_edit_requests")
}

model GymFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  gymId     String   @map("gym_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  gym  Gym  @relation(fields: [gymId], references: [id])

  @@unique([userId, gymId])
  @@map("gym_favorites")
}
