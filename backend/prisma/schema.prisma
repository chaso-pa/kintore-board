generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String   @id @default(uuid())
  deviceUuid      String   @unique @map("device_uuid")
  status          String   @default("active")
  // status は認証状態 (active / blocked)。role は権限で、別の概念として扱う。
  // 昇格は prisma studio または SQL による手動操作で、昇格用のエンドポイントは無い。
  role            String   @default("user")
  moderationScore Int      @default(0) @map("moderation_score")
  createdAt       DateTime @default(now()) @map("created_at")

  threads       Thread[]
  posts         Post[]
  workouts      Workout[]
  reports       Report[]
  gyms          Gym[]
  machines      Machine[]
  bookmarks     ThreadBookmark[]
  editRequests  GymEditRequest[]
  gymFavorites  GymFavorite[]

  @@map("users")
}

model Gym {
  id               String    @id @default(uuid())
  name             String
  address          String?
  latitude         Float?
  longitude        Float?
  visitorFee       Int?      @map("visitor_fee")
  monthlyFee       Int?      @map("monthly_fee")
  visitorAvailable Boolean   @default(false) @map("visitor_available")
  description      String?   @db.Text
  hours            String?
  hasParking       Boolean   @default(false) @map("has_parking")
  hasShower        Boolean   @default(false) @map("has_shower")
  hasLockerRoom    Boolean   @default(false) @map("has_locker_room")
  dumbbellMaxKg    Int?      @map("dumbbell_max_kg")
  barbellType      String?   @map("barbell_type")
  powerRackCount   Int?      @map("power_rack_count")
  sourceType       String    @default("user") @map("source_type")
  // モデレーション状態 (pending / active / rejected)。既存行を公開のまま残すため
  // デフォルトは active で、新規作成はコード側が明示的に pending を入れる。
  status           String    @default("active")
  lastUpdatedAt    DateTime  @updatedAt @map("last_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String    @map("created_by_user_id")

  createdBy    User             @relation(fields: [createdByUserId], references: [id])
  gymMachines  GymMachine[]
  threads      Thread[]
  photos       GymPhoto[]
  editRequests GymEditRequest[]
  favorites    GymFavorite[]

  @@map("gyms")
}

model GymPhoto {
  id               String @id @default(uuid())
  gymId            String @map("gym_id")
  imageUrl         String @map("image_url")
  uploadedByUserId String @map("uploaded_by_user_id")
  status           String @default("active")
  // 「最古の pending の経過時間」を写真についても出せるようにするために追加した。
  // 既存行が「今」になるが、この指標は pending 行しか読まず既存行は全て active なので影響しない。
  createdAt        DateTime @default(now()) @map("created_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@map("gym_photos")
}

model Machine {
  id              String   @id @default(uuid())
  name            String
  manufacturer    String?
  bodyPart        String?  @map("body_part")
  category        String?
  notes           String?  @db.Text
  createdByUserId String   @map("created_by_user_id")
  // Gym.status と同じ規約。既存行は active、新規はコード側で pending。
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")

  createdBy   User         @relation(fields: [createdByUserId], references: [id])
  gymMachines GymMachine[]
  threads     Thread[]
  photos      MachinePhoto[]

  @@map("machines")
}

model GymMachine {
  gymId     String @map("gym_id")
  machineId String @map("machine_id")

  gym     Gym     @relation(fields: [gymId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])

  @@id([gymId, machineId])
  @@map("gym_machines")
}

model MachinePhoto {
  id               String @id @default(uuid())
  machineId        String @map("machine_id")
  imageUrl         String @map("image_url")
  uploadedByUserId String @map("uploaded_by_user_id")
  status           String @default("active")
  // GymPhoto.createdAt と同じ理由。
  createdAt        DateTime @default(now()) @map("created_at")

  machine Machine @relation(fields: [machineId], references: [id])

  @@map("machine_photos")
}

model Thread {
  id              String   @id @default(uuid())
  type            String
  title           String
  category        String?
  gymId           String?  @map("gym_id")
  machineId       String?  @map("machine_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  status          String   @default("active")

  createdBy User             @relation(fields: [createdByUserId], references: [id])
  gym       Gym?             @relation(fields: [gymId], references: [id])
  machine   Machine?         @relation(fields: [machineId], references: [id])
  posts     Post[]
  bookmarks ThreadBookmark[]

  @@map("threads")
}

model ThreadBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  threadId  String   @map("thread_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  thread Thread @relation(fields: [threadId], references: [id])

  @@unique([userId, threadId])
  @@map("thread_bookmarks")
}

model Post {
  id                String   @id @default(uuid())
  threadId          String   @map("thread_id")
  userId            String   @map("user_id")
  anonymousThreadId String   @map("anonymous_thread_id")
  replyToId         String?  @map("reply_to_id")
  body              String   @db.Text
  helpfulCount      Int      @default(0) @map("helpful_count")
  createdAt         DateTime @default(now()) @map("created_at")
  status            String   @default("active")

  thread Thread @relation(fields: [threadId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("posts")
}

model Workout {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  trainedOn DateTime @map("trained_on")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User         @relation(fields: [userId], references: [id])
  sets WorkoutSet[]

  @@map("workouts")
}

model WorkoutSet {
  id           String  @id @default(uuid())
  workoutId    String  @map("workout_id")
  exerciseName String  @map("exercise_name")
  weight       Float?
  reps         Int?
  sets         Int?
  memo         String?
  spotted      Boolean @default(false)
  sortOrder    Int     @default(0) @map("sort_order")

  workout Workout @relation(fields: [workoutId], references: [id])

  @@map("workout_sets")
}

model Report {
  id               String   @id @default(uuid())
  targetType       String   @map("target_type")
  targetId         String   @map("target_id")
  reportedByUserId String   @map("reported_by_user_id")
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")
  status           String   @default("pending")

  reportedBy User @relation(fields: [reportedByUserId], references: [id])

  @@map("reports")
}

model GymEditRequest {
  id        String   @id @default(uuid())
  gymId     String   @map("gym_id")
  userId    String   @map("user_id")
  category  String
  body      String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  gym  Gym  @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("gym_edit_requests")
}

model GymFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  gymId     String   @map("gym_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  gym  Gym  @relation(fields: [gymId], references: [id])

  @@unique([userId, gymId])
  @@map("gym_favorites")
}
